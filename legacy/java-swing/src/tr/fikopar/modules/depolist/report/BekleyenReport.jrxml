	<variable name="tutar" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($F{fiyat}==null ? BigDecimal.ZERO : $F{fiyat}).multiply($F{bakiye}==null ? BigDecimal.ZERO : $F{bakiye})]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="toplam" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{tutar}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="isk1_fiyat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{tutar}.multiply($F{iskonto1} == null ? BigDecimal.ZERO : $F{iskonto1}).divide(new BigDecimal(100))]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="isk2_fiyat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{tutar}.subtract($V{isk1_fiyat}).multiply($F{iskonto2}==null ? BigDecimal.ZERO : $F{iskonto2}).divide(new BigDecimal(100))]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="isk_toplam" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{isk1_fiyat}.add($V{isk2_fiyat})]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="kdv_fiyat" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{tutar}.subtract($V{isk1_fiyat}).subtract($V{isk2_fiyat}).multiply($F{kdv}==null ? BigDecimal.ZERO : $F{kdv}).divide(new BigDecimal(100))]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
	<variable name="kdv_toplam" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{kdv_fiyat}]]></variableExpression>
		<initialValueExpression><![CDATA[BigDecimal.ZERO]]></initialValueExpression>
	</variable>
