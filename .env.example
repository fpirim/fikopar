PORT=8080
DATABASE_URL=postgres://fikopar:fikopar@localhost:5432/fikopar?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
UPLOAD_DIR=uploads/avatars
ADMIN_DEFAULT_EMAIL=admin@fikopar.local
ADMIN_DEFAULT_PASSWORD=admin123
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_ENV=development
# Reported by GET /healthz; set by the release build.
APP_VERSION=dev
# Set to the built frontend (frontend/dist) to serve the SPA from the backend.
STATIC_DIR=

# Sentry-compatible error tracking; empty disables it.
SENTRY_DSN=
SENTRY_RELEASE=
