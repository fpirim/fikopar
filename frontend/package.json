{
  "name": "fikopar-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "knip": "knip",
    "depcruise": "depcruise src",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:cov": "playwright test --config playwright.coverage.config.ts",
    "cov:e2e": "npm run e2e:cov && nyc report && sed -i.bak -E 's#^SF:(.*/)?(src/)#SF:frontend/src/#' coverage-e2e/lcov.info && rm -f coverage-e2e/lcov.info.bak",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "e2e:msw": "playwright test --config playwright.msw.config.ts",
    "screens": "SCREENS=1 playwright test --config playwright.msw.config.ts screens",
    "stack:e2e": "docker compose -f ../docker-compose.yml -p fikopar-e2e --profile e2e up -d --build --wait e2e-db e2e-api",
    "stack:e2e:down": "docker compose -f ../docker-compose.yml -p fikopar-e2e --profile e2e down -v",
    "seed": "node --experimental-strip-types e2e/real/seed.ts",
    "dev:real": "VITE_API_TARGET=${E2E_API_URL:-http://localhost:18080} vite",
    "e2e:real": "playwright test --config playwright.real.config.ts --grep-invert \"@v11|@v12|@v13|@v14|@v15\"",
    "e2e:real:v11": "playwright test --config playwright.real.config.ts --grep-invert \"@v12|@v13|@v14|@v15\"",
    "e2e:real:v12": "playwright test --config playwright.real.config.ts --grep-invert \"@v13|@v14|@v15\"",
    "e2e:real:v13": "playwright test --config playwright.real.config.ts --grep-invert \"@v14|@v15\"",
    "e2e:real:v14": "playwright test --config playwright.real.config.ts --grep-invert @v15",
    "e2e:real:v15": "playwright test --config playwright.real.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/react": "^10.53.1",
    "ag-grid-community": "30.2.1",
    "ag-grid-react": "30.2.1",
    "autonumeric": "^4.10.10",
    "axios": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.8",
    "react-phone-input-2": "^2.15.1",
    "react-router-dom": "^7.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.20",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "msw": "^3.0.0",
    "nyc": "^18.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.1.0",
    "vite-plugin-istanbul": "^9.0.0",
    "vitest": "^4.1.7"
  }
}
