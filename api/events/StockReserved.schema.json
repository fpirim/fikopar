{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fikopar.fpirim.me/schemas/events/StockReserved.schema.json",
  "title": "StockReserved",
  "description": "A draft saved its reservations (contracts v1.4): per line min(qty, available) in the document depot, until expiresAt (save + 48 h). Emitted in the save transaction, only by drafts that move stock OUT and have lines (v1.5); lines holding nothing are listed with reserved \"0\".",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "StockReserved"
    },
    "version": {
      "const": 1
    },
    "aggregateType": {
      "const": "document"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "expiresAt",
        "lines"
      ],
      "properties": {
        "documentId": {
          "type": "integer"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lineId",
              "partId",
              "requested",
              "reserved",
              "availableAfter"
            ],
            "properties": {
              "lineId": {
                "type": "integer"
              },
              "partId": {
                "type": "integer"
              },
              "requested": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
              },
              "reserved": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
              },
              "availableAfter": {
                "type": "string",
                "pattern": "^-?\\d{1,14}(\\.\\d{1,4})?$",
                "description": "onHand − reserved in the depot after this reservation"
              }
            }
          }
        }
      }
    }
  }
}
