{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fikopar.fpirim.me/schemas/events/InstrumentStatusChanged.schema.json",
  "title": "InstrumentStatusChanged",
  "description": "A cheque or note moved along its state machine.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "InstrumentStatusChanged"
    },
    "version": {
      "const": 1
    },
    "aggregateType": {
      "const": "instrument"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instrumentId",
        "instrumentNo",
        "instrumentType",
        "action",
        "amount",
        "currency",
        "dueDate",
        "toStatus",
        "seq",
        "remaining"
      ],
      "properties": {
        "instrumentId": {
          "type": "integer"
        },
        "instrumentNo": {
          "type": "string"
        },
        "instrumentType": {
          "enum": [
            "RECEIVABLE_CHEQUE",
            "RECEIVABLE_NOTE",
            "PAYABLE_CHEQUE",
            "PAYABLE_NOTE"
          ]
        },
        "action": {
          "enum": [
            "REGISTER",
            "DEPOSIT_TO_BANK",
            "COLLECT_AT_BANK",
            "COLLECT_BY_HAND",
            "BOUNCE",
            "ENDORSE",
            "PROTEST",
            "RETURN",
            "PAY"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "settledAmount": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^-?\\d{1,16}\\.\\d{2}$",
          "description": "Collected or paid in this step"
        },
        "remaining": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$",
          "description": "amount − Σ settled after this step"
        },
        "currency": {
          "const": "TRY",
          "description": "TRY only in contracts v1.1."
        },
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "fromStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "toStatus": {
          "enum": [
            "PORTFOLIO",
            "DEPOSITED",
            "PARTIALLY_COLLECTED",
            "COLLECTED",
            "BOUNCED",
            "ENDORSED",
            "PROTESTED",
            "RETURNED",
            "ISSUED",
            "PAID"
          ]
        },
        "seq": {
          "type": "integer"
        },
        "counterpartySicilId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "receiptId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "journalEntryId": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
