{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fikopar.fpirim.me/schemas/events/DocumentPosted.schema.json",
  "title": "DocumentPosted",
  "description": "A trade document was posted (contracts v1.4). Consumers: ledger (skipped when postsToLedger is false: waybills and return waybills; posting table in ADR-0013), stock (skipped when movesStock is false: price differences and documents that bill a waybill), DocumentExporter (no-op until e-Fatura). Idempotent on the document id.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "DocumentPosted"
    },
    "version": {
      "const": 1
    },
    "aggregateType": {
      "const": "document"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "documentNo",
        "documentType",
        "sicilId",
        "documentDate",
        "postsToLedger",
        "movesStock",
        "currency",
        "grandTotal",
        "lines",
        "direction",
        "grossTotal",
        "discountTotal",
        "netTotal",
        "vatTotal"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "waybillDocumentId"
            ],
            "properties": {
              "waybillDocumentId": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "movesStock": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentType": {
                "enum": [
                  "SALES_WAYBILL",
                  "SALES_RETURN_WAYBILL",
                  "PURCHASE_WAYBILL",
                  "PURCHASE_RETURN_WAYBILL"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "postsToLedger": {
                "const": false
              },
              "movesStock": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "documentType": {
                "const": "PRICE_DIFFERENCE"
              }
            }
          },
          "then": {
            "properties": {
              "movesStock": {
                "const": false
              }
            }
          }
        }
      ],
      "properties": {
        "documentId": {
          "type": "integer"
        },
        "documentNo": {
          "type": "string"
        },
        "documentType": {
          "enum": [
            "SALES_INVOICE_WITH_WAYBILL",
            "SALES_INVOICE",
            "SALES_WAYBILL",
            "SALES_RETURN",
            "SALES_RETURN_WAYBILL",
            "PURCHASE_INVOICE_WITH_WAYBILL",
            "PURCHASE_INVOICE",
            "PURCHASE_WAYBILL",
            "PURCHASE_RETURN",
            "PURCHASE_RETURN_WAYBILL",
            "PRICE_DIFFERENCE"
          ]
        },
        "direction": {
          "enum": [
            "SALES",
            "PURCHASE"
          ],
          "description": "For PRICE_DIFFERENCE, taken from the linked document"
        },
        "sicilId": {
          "type": "integer"
        },
        "documentDate": {
          "type": "string",
          "format": "date"
        },
        "dueDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "linkedDocumentId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "waybillDocumentId": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Waybill billed by this document; when set, movesStock is false"
        },
        "postsToLedger": {
          "type": "boolean"
        },
        "movesStock": {
          "type": "boolean"
        },
        "currency": {
          "const": "TRY",
          "description": "TRY only in contracts v1.1."
        },
        "grossTotal": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "discountTotal": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "netTotal": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "vatTotal": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "grandTotal": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lineId",
              "lineNo",
              "partId",
              "qty",
              "unitPrice",
              "discount1Pct",
              "discount2Pct",
              "vatPct",
              "grossAmount",
              "discountAmount",
              "netAmount",
              "vatAmount"
            ],
            "properties": {
              "lineId": {
                "type": "integer",
                "description": "Stock movements use it as source_id"
              },
              "lineNo": {
                "type": "integer"
              },
              "partId": {
                "type": "integer"
              },
              "qty": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
              },
              "unitPrice": {
                "type": "string",
                "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
              },
              "discount1Pct": {
                "type": "string"
              },
              "discount2Pct": {
                "type": "string"
              },
              "vatPct": {
                "type": "string"
              },
              "netAmount": {
                "type": "string",
                "pattern": "^-?\\d{1,16}\\.\\d{2}$"
              },
              "vatAmount": {
                "type": "string",
                "pattern": "^-?\\d{1,16}\\.\\d{2}$"
              },
              "grossAmount": {
                "type": "string",
                "pattern": "^-?\\d{1,16}\\.\\d{2}$"
              },
              "discountAmount": {
                "type": "string",
                "pattern": "^-?\\d{1,16}\\.\\d{2}$"
              },
              "originLineId": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "billedLineId": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "salesRepUserId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "creditOverride": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "reason",
            "userId",
            "excess"
          ],
          "properties": {
            "reason": {
              "type": "string"
            },
            "userId": {
              "type": "integer"
            },
            "excess": {
              "type": "string",
              "pattern": "^-?\\d{1,16}\\.\\d{2}$"
            }
          },
          "description": "Set when an admin posted over the credit limit"
        }
      }
    }
  }
}
