{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fikopar.fpirim.me/schemas/events/PriceChanged.schema.json",
  "title": "PriceChanged",
  "description": "A list price row was added by setPartPrice or setPrices (one event per row). Imports emit PriceListImported instead. depotId is null.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "PriceChanged"
    },
    "version": {
      "const": 1
    },
    "aggregateType": {
      "const": "part"
    },
    "depotId": {
      "type": "null"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priceId",
        "partId",
        "catalogId",
        "price",
        "validFrom",
        "source"
      ],
      "properties": {
        "priceId": {
          "type": "integer"
        },
        "partId": {
          "type": "integer"
        },
        "catalogId": {
          "type": "integer"
        },
        "price": {
          "type": "string",
          "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
        },
        "previousPrice": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^\\d{1,14}(\\.\\d{1,4})?$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Price valid the day before validFrom"
        },
        "validFrom": {
          "type": "string",
          "format": "date"
        },
        "source": {
          "enum": [
            "MANUAL"
          ]
        }
      }
    }
  }
}
